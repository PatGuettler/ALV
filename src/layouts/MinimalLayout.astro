---
import '../styles/fonts.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html
  lang="en"
  style={`--retreat-image: url('${base}assets/warrior-retreat-hero.jpg'); --bg-photo: url('${base}assets/warrior-retreat-hero.jpg')`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#39435A" />
    <link rel="icon" type="image/png" href={`${base}assets/93198b7ec08230d7.png`} />
    <title>{title}</title>
  </head>
  <body>
    <slot />
  </body>
</html>
