---
import CrisisBar from '../components/site/CrisisBar.astro';
import CrisisFloat from '../components/site/CrisisFloat.astro';
import Navigation from '../components/site/Navigation.astro';
import Footer from '../components/site/Footer.astro';
import ContactModal from '../components/site/ContactModal.astro';
import NewsletterModal from '../components/site/NewsletterModal.astro';
import FeaturedFundraiser from '../components/site/FeaturedFundraiser.astro';

import '../styles/fonts.css';
import '../styles/foundation.css';
import '../styles/navigation.css';
import '../styles/forms.css';
import '../styles/status.css';
import '../styles/responsive.css';
import '../styles/contrast.css';
import '../styles/featured-fundraiser.css';

interface Props {
  pageId: string;
  title: string;
  description: string;
}

const { pageId, title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonicalRoutes: Record<string, string> = {
  home: '',
  news: 'news/',
  warrior: 'warrior-retreat/',
  circle: 'av-circle/',
  about: 'about/',
  active: 'av-active/',
  topgolf: 'topgolf/',
  events: 'events/',
  resources: 'resources/',
  privacy: 'privacy/',
};
const canonical = new URL(canonicalRoutes[pageId] ?? '', 'https://alabamaveteran.org/');
const isProduction = import.meta.env.SITE_ENV === 'production';
const socialImage = new URL('/assets/d6f82f3f7b70368f.webp', canonical.origin);
const favicon = `${base}assets/93198b7ec08230d7.png`;
const sharedHeroImage =
  pageId === 'home' || pageId === 'resources'
    ? 'https://alabamaveteran.org/wp-content/uploads/2025/01/your-next-mission-1.webp'
    : undefined;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': 'https://alabamaveteran.org/#organization',
      name: 'Alabama Veteran',
      url: 'https://alabamaveteran.org/',
      logo: 'https://alabamaveteran.org/assets/93198b7ec08230d7.png',
    },
    {
      '@type': 'WebPage',
      '@id': `${canonical.href}#webpage`,
      name: title,
      description,
      url: canonical.href,
      isPartOf: {
        '@type': 'WebSite',
        '@id': 'https://alabamaveteran.org/#website',
        name: 'Alabama Veteran',
        url: 'https://alabamaveteran.org/',
        publisher: { '@id': 'https://alabamaveteran.org/#organization' },
      },
    },
  ],
};
---

<!doctype html>
<html
  lang="en"
  data-base-path={base}
  data-page={pageId}
  style={`--site-hero-image: url('${base}assets/d6f82f3f7b70368f.webp')`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />
    {!isProduction && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1A2030" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/png" href={favicon} />
    {
      sharedHeroImage && (
        <link rel="preload" as="image" href={sharedHeroImage} fetchpriority="high" />
      )
    }
    <meta property="og:site_name" content="Alabama Veteran" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:alt" content="Alabama Veteran community programs" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <CrisisBar />
    <Navigation />
    <FeaturedFundraiser />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <CrisisFloat />
    <ContactModal />
    <NewsletterModal />
    <script>
      import '../scripts/navigation.js';
      import '../scripts/forms.js';
      import '../scripts/panels.js';
    </script>
  </body>
</html>
