---
const base = import.meta.env.BASE_URL;
---

<section class="nc-hero">
  <div class="nc-stripe"></div>
  <div class="nc-inner">
    <div class="nc-eyebrow">AV News</div>
    <h1>Publishing Not <span class="red">Connected</span></h1>
    <p>
      News items will appear here only after an approved editorial source and publishing workflow
      are connected.
    </p>
    <div class="nc-btns">
      <a class="nc-btn" href={`${base}`}>Back to Home</a>
      <a
        class="nc-btn-o"
        href="https://app.alabamaveteran.org/widget/form/t9pQuFrpT0Yz2lYTwLVj?notrack=true"
        target="_blank"
        rel="noopener noreferrer">Get Help Now</a
      >
    </div>
  </div>
</section>
