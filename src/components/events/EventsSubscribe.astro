<section class="evp-subscribe" id="subscribe">
  <div class="container">
    <div class="evp-subscribe-inner">
      <div class="eyebrow ctr">Never Miss an Event</div>
      <h2>Add to Your <span class="red">Calendar</span></h2>
      <p>
        Subscribe to the Alabama Veteran event calendar and get every event automatically on your
        phone or computer.
      </p>
      <div class="evp-sub-btns">
        <a
          href="https://www.google.com/calendar/render?cid=webcal%3A%2F%2Falabamaveteran.org%2F%3Fpost_type%3Dtribe_events%26ical%3D1%26eventDisplay%3Dlist"
          class="evp-sub-btn"
          target="_blank"
          rel="noopener noreferrer">+ Google Calendar</a
        >
        <a
          href="webcal://alabamaveteran.org/?post_type=tribe_events&ical=1&eventDisplay=list"
          class="evp-sub-btn">+ Apple / iCal</a
        >
        <a
          href="https://outlook.office.com/owa?path=/calendar/action/compose&rru=addsubscription&url=webcal%3A%2F%2Falabamaveteran.org%2F%3Fpost_type%3Dtribe_events%26ical%3D1%26eventDisplay%3Dlist&name=Alabama+Veteran+Events"
          class="evp-sub-btn"
          target="_blank"
          rel="noopener noreferrer">+ Outlook 365</a
        >
        <a
          href="https://outlook.live.com/owa?path=/calendar/action/compose&rru=addsubscription&url=webcal%3A%2F%2Falabamaveteran.org%2F%3Fpost_type%3Dtribe_events%26ical%3D1%26eventDisplay%3Dlist&name=Alabama+Veteran+Events"
          class="evp-sub-btn"
          target="_blank"
          rel="noopener noreferrer">+ Outlook Live</a
        >
        <a
          href="https://alabamaveteran.org/connect/?ical=1"
          class="evp-sub-btn"
          target="_blank"
          rel="noopener noreferrer">+ Download .ics</a
        >
      </div>
    </div>
  </div>
</section>
