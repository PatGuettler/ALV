---
const base = import.meta.env.BASE_URL;
---

<section class="evp-fundraising" id="fundraising">
  <div class="container">
    <div class="evp-fund-header">
      <div class="eyebrow ctr">Signature Fundraising Events</div>
      <h2>Make an <span class="red">Impact</span></h2>
      <p>
        These events fund everything we do. Your participation — whether you sponsor, register, or
        simply show up — directly supports Alabama's veteran community.
      </p>
    </div>
    <div class="evp-fund-grid">
      <article class="evp-fund-card">
        <div class="evp-fund-photo">
          <img
            src={`${base}assets/events-war-on-the-greens.webp`}
            alt="Golfers at War on the Greens"
            width="800"
            height="520"
            loading="lazy"
            decoding="async"
          />
          <img
            class="evp-fund-logo"
            src="https://alabamaveteran.org/wp-content/uploads/2025/02/AV-Initiative_War-on-The-Greens.png"
            alt="War on the Greens — Alabama Veteran Initiative"
            width="203"
            height="203"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="evp-fund-card-body" id="wog-card">
          <div class="evp-fund-eyebrow">Annual Golf Tournament · Fundraiser</div>
          <h3 class="evp-fund-card-title">War on the Greens</h3>
          <div class="evp-fund-card-meta">
            <div class="evp-fund-meta-row">
              <span class="evp-fund-meta-icon" aria-hidden="true">📅</span>
              October 19, 2026 · 7:30 AM – 3:30 PM
            </div>
            <div class="evp-fund-meta-row">
              <span class="evp-fund-meta-icon" aria-hidden="true">📍</span>
              Inverness Country Club · Birmingham, AL
            </div>
          </div>
          <p class="evp-fund-card-desc">
            Honoring Alabama's fallen heroes, one swing at a time. The War on the Greens pairs
            veterans with players to foster camaraderie, share stories, and showcase the value of
            those who served. Each year, the event is dedicated to a Gold Star family — ensuring
            their loved one's sacrifice is never forgotten. Great golf, a powerful mission, and a
            community that shows up.
          </p>
          <div class="wog-hsv-wrap" data-wog-hsv>
            <button class="wog-hsv-toggle" type="button" data-wog-hsv-toggle aria-expanded="false">
              <span class="wog-hsv-preview">
                <span class="wog-hsv-badge">Also Annual</span>
                <span class="wog-hsv-loc">📍 Huntsville, AL — RTJ Hampton Cove</span>
                <span class="wog-hsv-yr">2027 · Date TBD</span>
              </span>
              <span class="wog-hsv-arrow" data-wog-hsv-arrow>▼</span>
            </button>
            <div class="wog-hsv-body">
              <div class="wog-hsv-eyebrow">Annual Golf Tournament · Fundraiser</div>
              <div class="wog-hsv-title">War on the Greens — Huntsville</div>
              <div class="wog-hsv-meta">
                <span>📅 2027 — Date Coming Soon</span>
                <span>📍 RTJ Hampton Cove · Huntsville, AL</span>
              </div>
              <p class="wog-hsv-desc">
                The northern gateway of the Robert Trent Jones Golf Trail, Hampton Cove sits along
                the Flint River foothills featuring 54 championship holes. Same mission as
                Birmingham — honoring fallen heroes, pairing veterans with players, and dedicating
                each round to a Gold Star family.
              </p>
              <div class="wog-hsv-btns">
                <a
                  href="https://events.alabamaveteran.org/home--alabama-veteran-page-2499-6960"
                  class="btn-b"
                  target="_blank"
                  rel="noopener noreferrer">Sponsorship Info</a
                >
                <a
                  href="https://events.alabamaveteran.org/home--alabama-veteran-page-2499-6960-9200"
                  class="btn-r"
                  target="_blank"
                  rel="noopener noreferrer">Register Team</a
                >
              </div>
            </div>
          </div>
          <div class="evp-fund-card-btns">
            <button class="btn-r" type="button" data-wog-open="wog-team-modal">Team Info</button>
            <a
              href="https://onecau.se/wog"
              class="btn-r evp-fund-signup"
              target="_blank"
              rel="noopener noreferrer">Sign Up</a
            >
            <button class="btn-b" type="button" data-wog-open="wog-sponsor-modal">
              Sponsorship Info
            </button>
          </div>
        </div>
      </article>
      <article class="evp-fund-card dark">
        <img
          src={`${base}assets/events-salute-to-service.webp`}
          alt="Salute to Service Gala"
          class="evp-fund-card-img"
          width="800"
          height="520"
          loading="lazy"
          decoding="async"
        />
        <div class="evp-fund-card-body" id="salute-card">
          <div class="evp-fund-eyebrow">Annual Gala · Fundraiser</div>
          <h3 class="evp-fund-card-title">Salute to Service</h3>
          <div class="evp-fund-card-meta">
            <div class="evp-fund-meta-row">
              <span class="evp-fund-meta-icon" aria-hidden="true">📅</span>
              2027 — Date Coming Soon
            </div>
            <div class="evp-fund-meta-row">
              <span class="evp-fund-meta-icon" aria-hidden="true">📍</span>
              Birmingham, AL
            </div>
          </div>
          <div class="evp-anticipate">
            <strong>Something Bigger Is Coming in 2027</strong>
            We are revamping the Salute to Service Gala for 2027 — a bigger night, a bolder mission, and
            an experience worthy of the veterans we serve. Stay connected and be the first to know when
            details drop.
          </div>
          <p class="evp-fund-card-desc">
            The Salute to Service Gala is Alabama Veteran's premier fundraising evening — bringing
            together community leaders, supporters, and veterans for a night of recognition, impact,
            and celebration. Every dollar raised goes directly to funding retreats, resources, and
            programs for Alabama's veterans.
          </p>
          <div class="evp-fund-card-btns">
            <a href="mailto:gala@alabamaveteran.org" class="btn-r">Stay Notified</a>
            <a href="mailto:gala@alabamaveteran.org" class="btn-ow evp-fund-ghost">
              Sponsorship Inquiries
            </a>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('[data-wog-hsv-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const wrap = button.closest('[data-wog-hsv]');
      if (!(wrap instanceof HTMLElement) || !(button instanceof HTMLButtonElement)) return;
      const open = wrap.classList.toggle('open');
      button.setAttribute('aria-expanded', String(open));
      const arrow = wrap.querySelector('[data-wog-hsv-arrow]');
      if (arrow) arrow.textContent = open ? '▲' : '▼';
    });
  });
  document.querySelectorAll('[data-wog-open]').forEach((button) => {
    button.addEventListener('click', () => {
      const id = button.getAttribute('data-wog-open');
      document.getElementById(id)?.classList.add('open');
    });
  });
</script>
