---
const base = import.meta.env.BASE_URL;
---

<section class="badge-sec" id="badge">
  <div class="badge-inner">
    <div class="badge-hdr">
      <p class="sec-label">Corporate Recognition</p>
      <h2 class="sec-title" style="color: #fff; margin-bottom: 1rem">YOUR BADGE OF HONOR.</h2>
      <p class="sec-desc" style="max-width: 560px; margin: 0 auto">
        Every AV Circle business member receives the official Proud Supporter designation, a mark
        recognized across Alabama that sets your brand apart.
      </p>
    </div>
    <div class="badge-showcase">
      <img
        class="ps-badge-img"
        src={`${base}assets/458a5b462f6dc1f0.webp`}
        alt="Proud Supporter of Alabama Veteran official badge"
      />
      <div class="badge-info">
        <h3>TELL ALABAMA<br />WHERE YOU STAND.</h3>
        <p>
          The Proud Supporter badge is your public declaration that your business stands with
          Alabama's veterans. Display it everywhere your brand lives and it builds trust, loyalty,
          and community respect.
        </p>
        <ul class="badge-list">
          <li>Website, storefront and all print marketing</li>
          <li>Email signatures, proposals and pitch decks</li>
          <li>Social media profile frames and campaign graphics</li>
          <li>Annual reports, CSR filings and ESG documentation</li>
          <li>Full print-ready color and reversed white files provided</li>
        </ul>
      </div>
    </div>
    <div class="badge-steps">
      <div class="bstep">
        <div class="bstep-num">01</div>
        <h4>JOIN THE CIRCLE</h4>
        <p>
          Choose your corporate tier and complete your enrollment as a Pillar, Champions League
          member, or Titan.
        </p>
      </div>
      <div class="bstep">
        <div class="bstep-num">02</div>
        <h4>RECEIVE YOUR BADGE</h4>
        <p>
          Get your full Proud Supporter brand package with digital files, print-ready art, and
          social assets ready to use.
        </p>
      </div>
      <div class="bstep">
        <div class="bstep-num">03</div>
        <h4>SHOW YOUR SUPPORT</h4>
        <p>
          Display it proudly. Your customers, community, and employees will know exactly where your
          business stands.
        </p>
      </div>
    </div>
  </div>
</section>
