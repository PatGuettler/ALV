---
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <div class="hero-bg" style={`background-image: url('${base}assets/50f5d7eee9055ae0.webp')`}></div>
  <div class="hero-content">
    <div class="ps-hero-badge">
      <img src={`${base}assets/458a5b462f6dc1f0.webp`} alt="Proud Supporter of Alabama Veteran" />
    </div>
    <div class="ps-pill">
      <div class="ps-pill-text">
        <span class="l1">Official Designation</span><span class="l2"
          >PROUD SUPPORTER &nbsp;|&nbsp; ALABAMA VETERAN</span
        >
      </div>
    </div>
    <p class="circle-trust-hook">Are you in the Circle of Trust?</p>
    <h1>AV <span class="red">CIRCLE</span></h1>
    <p class="hero-sub">
      A community of businesses and Alabamians united behind one mission: ensuring every veteran
      finds purpose, support, and belonging after service.
    </p>
    <div class="hero-btns">
      <a href="#levels" class="btn-red">Become a Circle Member</a><a
        href="#programs"
        class="btn-ghost">Learn About Our Programs</a
      >
    </div>
  </div>
  <div class="scroll-cue">
    <svg viewBox="0 0 24 24"><polyline points="6 9 12 15 18 9"></polyline></svg><span>scroll</span>
  </div>
</section>
