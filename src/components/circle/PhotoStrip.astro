---
const base = import.meta.env.BASE_URL;
---

<div class="photo-strip">
  <div class="strip-item">
    <img
      src={`${base}assets/66ef1b3eae3e0cda.webp`}
      alt="AV Ambassador community event with Alabama Veteran banner"
    />
    <div class="strip-overlay"><span class="strip-lbl">AV Ambassador Events</span></div>
  </div>
  <div class="strip-item">
    <img src={`${base}assets/c00cd5a601c1e73d.webp`} alt="Marriage Retreat veterans on the beach" />
    <div class="strip-overlay"><span class="strip-lbl">Warrior and Marriage Retreats</span></div>
  </div>
  <div class="strip-item">
    <img src={`${base}assets/8e10747b7f9c40b1.webp`} alt="AV Active rowing event on the lake" />
    <div class="strip-overlay"><span class="strip-lbl">AV Active Community</span></div>
  </div>
</div>
