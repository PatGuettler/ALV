---
const base = import.meta.env.BASE_URL;
---

<section class="circle-preview">
  <div class="container">
    <div class="cp-inner">
      <div class="eyebrow ctr">Recurring Giving Program</div>
      <h2 class="cp-title">Join the<br />AV Circle</h2>
      <p class="cp-body">
        Become a sustaining force behind the mission. Monthly or annual giving that keeps the
        Warrior Retreat, the 9 Line, and every AV program running year-round.
      </p>
      <div class="cp-companies">
        <div class="circ-co-label">Current AV Circle Companies</div>
        <div class="circ-co-row">
          <div class="cp-co">
            <img
              src="https://alabamaveteran.org/wp-content/uploads/2025/02/al-power-sponsor-logo.webp"
              alt="Alabama Power"
            />
          </div>
          <div class="cp-co">
            <img
              src="https://alabamaveteran.org/wp-content/uploads/2025/01/Magna-Kamtek-logo.webp"
              alt="Magna Kamtek"
            />
          </div>
          <div class="cp-co">
            <img
              src="https://alabamaveteran.org/wp-content/uploads/2025/01/Vulcan-Materials-Logo.webp"
              alt="Vulcan Materials"
            />
          </div>
          <div class="cp-co">
            <img
              src="https://alabamaveteran.org/wp-content/uploads/2025/02/fsci-sponsor-logo.webp"
              alt="Frazier Splicing & Construction"
            />
          </div>
        </div>
      </div>
      <div class="cp-btns">
        <a class="btn-wh" href={`${base}av-circle/`}>See All Tiers &amp; Join</a><a
          href="https://my.onecause.com/fundraiser/organizations/069c5aa7-32be-4377-be03-b101310beee7/fundraisers/fundraiser:fd94be2b-b4ba-4e2a-b112-1ae8d3c376ee"
          class="btn-ow-red"
          target="_blank"
          rel="noopener noreferrer">Donate One Time</a
        >
      </div>
    </div>
  </div>
</section>
