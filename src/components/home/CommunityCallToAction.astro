---
const base = import.meta.env.BASE_URL;
---

<section class="comm-section">
  <div class="container">
    <div class="comm-inner">
      <div class="redbar ctr" style="margin-bottom: 28px"></div>
      <h2 class="comm-title">You Served.<br />Now Come Home.</h2>
      <p class="comm-body">
        The Alabama Veteran community was built by people just like you. Come be part of something
        that honors your service and connects you with those who lived it too.
      </p>
      <div class="comm-btns">
        <a class="btn-r" href={`${base}av-circle/`}>Join the AV Circle</a><a
          href="https://app.alabamaveteran.org/widget/form/t9pQuFrpT0Yz2lYTwLVj?notrack=true"
          class="btn-ow"
          target="_blank"
          rel="noopener noreferrer">Get Help Now</a
        >
      </div>
    </div>
  </div>
</section>
