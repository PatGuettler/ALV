---
const base = import.meta.env.BASE_URL;
---

<section class="transp-strip">
  <div class="container">
    <div class="transp-inner">
      <div class="transp-text">
        <h3>Volunteer-Powered. Mission-Driven.</h3>
        <p>
          Current financial disclosures are available from the independent public filing linked
          here.
        </p>
      </div>
      <div class="transp-badges">
        <img
          src="https://alabamaveteran.org/wp-content/uploads/2026/01/canded-badge.png"
          alt="Candid Platinum"
        />
      </div>
      <div class="transp-cta">
        <a
          href="https://my.onecause.com/fundraiser/organizations/069c5aa7-32be-4377-be03-b101310beee7/fundraisers/fundraiser:fd94be2b-b4ba-4e2a-b112-1ae8d3c376ee"
          class="btn-r"
          target="_blank"
          rel="noopener noreferrer">Donate Now</a
        ><a
          href="https://projects.propublica.org/nonprofits/organizations/813938705/"
          class="btn-ow"
          target="_blank"
          rel="noopener noreferrer">View Financials</a
        >
      </div>
    </div>
  </div>
</section>
