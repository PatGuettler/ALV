---
const base = import.meta.env.BASE_URL;
---

<section class="hero">
  <img
    class="hero-bg"
    src="https://alabamaveteran.org/wp-content/uploads/2025/01/your-next-mission-1.webp"
    alt=""
    width="900"
    height="900"
    fetchpriority="high"
    decoding="async"
  />
  <div class="hero-stripe-l"></div>
  <div class="hero-stripe-b"></div>
  <div class="hero-inner">
    <div class="hero-ey">
      <div class="hero-ey-line"></div>
      <span class="hero-ey-txt">Alabama Veteran — We've Got Your Six, 24/7</span>
    </div>
    <h1 class="hero-title">
      YOUR<br />NEXT<br /><span class="red">MISSION</span><br />STARTS HERE.
    </h1>
    <p class="hero-sub">
      Alabama Veteran exists to help veterans find purpose in their lives after service. Real
      support, real community, right here in Alabama.
    </p>
    <div class="hero-ctas">
      <a class="btn-r" href={`${base}warrior-retreat/`}>Warrior Retreat</a><a
        class="btn-r"
        href={`${base}av-circle/`}>Join the AV Circle</a
      ><a
        href="https://app.alabamaveteran.org/widget/form/oA6BYtFTZ47lbNChjt2h?notrack=true"
        class="btn-r"
        target="_blank"
        rel="noopener noreferrer">Become a Volunteer</a
      >
    </div>
  </div>
</section>
