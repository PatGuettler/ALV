---
import {
  EVENTS_CALENDAR_LIVE_FEED_URL,
  EVENTS_CALENDAR_STAGING_FEED_URL,
} from '../../scripts/events-calendar.js';

const base = import.meta.env.BASE_URL;
const feedUrl = `${base}data/events-calendar.json`;
const liveFeedUrl =
  import.meta.env.PUBLIC_EVENTS_FEED_URL ||
  (import.meta.env.SITE_ENV === 'staging'
    ? EVENTS_CALENDAR_STAGING_FEED_URL
    : EVENTS_CALENDAR_LIVE_FEED_URL);
---

<section
  class="ev-section"
  data-home-events
  data-feed-url={feedUrl}
  data-live-feed-url={liveFeedUrl}
  data-events-path={`${base}events/`}
>
  <div class="container">
    <div class="ev-layout ev-layout-list">
      <div>
        <div class="eyebrow">Upcoming Events</div>
        <h2 class="st wh">What's<br />Happening</h2>
        <p class="ev-intro">Everything going on across the Alabama Veteran community.</p>
        <div class="ev-list" data-home-event-list></div>
        <a href={`${base}events/#calendar`} class="ev-all">View Full Calendar →</a>
      </div>
    </div>
  </div>
</section>

<script>
  import '../../scripts/events-calendar.js';
</script>
