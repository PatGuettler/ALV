---
const sponsors = [
  {
    src: 'https://alabamaveteran.org/wp-content/uploads/2025/02/al-power-sponsor-logo.webp',
    alt: 'Alabama Power',
  },
  {
    src: 'https://alabamaveteran.org/wp-content/uploads/2025/02/altec-sponsor-logo.webp',
    alt: 'Altec',
  },
  {
    src: 'https://alabamaveteran.org/wp-content/uploads/2025/02/dunn_logo.png',
    alt: 'Dunn',
  },
  {
    src: 'https://alabamaveteran.org/wp-content/uploads/2025/02/Blue_Cross_Blue_Shield-2.webp',
    alt: 'BCBS Alabama',
  },
  {
    src: 'https://alabamaveteran.org/wp-content/uploads/2025/01/avadian-logo.webp',
    alt: 'Avadian',
  },
  {
    src: 'https://alabamaveteran.org/wp-content/uploads/2025/02/highlands-sponsor-logo.webp',
    alt: 'Highlands',
  },
  {
    src: 'https://alabamaveteran.org/wp-content/uploads/2025/01/country-financial-logo.webp',
    alt: 'Country Financial',
  },
  {
    src: 'https://alabamaveteran.org/wp-content/uploads/2025/01/Bryant-Bank-Master-Logo.webp',
    alt: 'Bryant Bank',
  },
  {
    src: 'https://alabamaveteran.org/wp-content/uploads/2025/02/honda-sponsor-logo.webp',
    alt: 'Honda',
  },
  {
    src: 'https://alabamaveteran.org/wp-content/uploads/2025/02/keltec-sponsor-logo.webp',
    alt: 'Kel-Tec',
  },
  {
    src: 'https://alabamaveteran.org/wp-content/uploads/2025/02/lakeshore-sponsor-logo.webp',
    alt: 'Lakeshore',
  },
  {
    src: 'https://alabamaveteran.org/wp-content/uploads/2025/01/Vulcan-Materials-Logo.webp',
    alt: 'Vulcan Materials',
  },
];
---

<section class="spon-section">
  <div class="container">
    <div class="spon-head">
      <div class="eyebrow ctr">Partners in the Mission</div>
      <h2 class="st bl" style="font-size: 38px">Thank You to Our Sponsors</h2>
    </div>
  </div>
  <div class="spon-marquee">
    <div class="spon-track">
      {
        sponsors.map(({ src, alt }) => (
          <div class="spon-item">
            <img src={src} alt={alt} loading="lazy" decoding="async" />
          </div>
        ))
      }
      {
        sponsors.map(({ src }) => (
          <div class="spon-item" aria-hidden="true">
            <img src={src} alt="" loading="lazy" decoding="async" />
          </div>
        ))
      }
    </div>
  </div>
</section>
