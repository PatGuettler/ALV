---
const base = import.meta.env.BASE_URL;
const sponsors = [
  { src: `${base}assets/sponsors/alabama-power.webp`, alt: 'Alabama Power' },
  { src: `${base}assets/sponsors/altec.webp`, alt: 'Altec' },
  { src: `${base}assets/sponsors/dunn.png`, alt: 'Dunn Companies' },
  { src: `${base}assets/sponsors/bcbs.webp`, alt: 'Blue Cross Blue Shield of Alabama' },
  { src: `${base}assets/sponsors/avadian.webp`, alt: 'Avadian Credit Union' },
  { src: `${base}assets/sponsors/highlands.webp`, alt: 'Church of the Highlands' },
  { src: `${base}assets/sponsors/country-financial.webp`, alt: 'COUNTRY Financial' },
  { src: `${base}assets/sponsors/bryant-bank.webp`, alt: 'Bryant Bank' },
  { src: `${base}assets/sponsors/honda.webp`, alt: 'Honda Manufacturing of Alabama' },
  { src: `${base}assets/sponsors/keltec.webp`, alt: 'Kel-Tec' },
  { src: `${base}assets/sponsors/lakeshore.webp`, alt: 'Lakeshore Foundation' },
  { src: `${base}assets/sponsors/vulcan-materials.webp`, alt: 'Vulcan Materials' },
];
---

<section class="spon-section" aria-label="Sponsors">
  <div class="container">
    <div class="spon-head">
      <div class="eyebrow ctr">Partners in the Mission</div>
      <h2>Thank You to Our Sponsors</h2>
    </div>
  </div>
  <div class="spon-marquee">
    <div class="spon-track">
      {
        sponsors.map(({ src, alt }) => (
          <div class="spon-item">
            <img
              src={src}
              alt={alt}
              height="42"
              loading="lazy"
              fetchpriority="low"
              decoding="async"
            />
          </div>
        ))
      }
      {
        sponsors.map(({ src }) => (
          <div class="spon-item" aria-hidden="true">
            <img src={src} alt="" height="42" loading="lazy" fetchpriority="low" decoding="async" />
          </div>
        ))
      }
    </div>
  </div>
</section>
