---
const base = import.meta.env.BASE_URL;
---

<section class="tgp-hero">
  <img
    src={`${base}assets/76f21b51a9cc15dc.webp`}
    alt="Veterans at Topgolf Birmingham"
    class="tgp-hero-img"
  />
  <div class="tgp-hero-overlay"></div>
  <div class="container">
    <div class="tgp-hero-inner">
      <a class="tgp-back" href={`${base}av-active/`}>Back to AV Active</a>
      <div class="eyebrow" style="margin-bottom: 14px">AV Active Initiative</div>
      <h1>Free <span class="red">Topgolf</span> for Vets &amp; First Responders</h1>
      <p class="tgp-hero-sub">
        Alabama Veteran is partnering with Topgolf Birmingham to offer free 2-hour bay sessions
        during Platinum Hours — at no cost to you. Open to veterans and first responders. Spots are
        limited.
      </p>
      <a
        href="https://app.alabamaveteran.org/widget/bookings/top-golf-av-active"
        class="btn-r"
        target="_blank"
        rel="noopener noreferrer"
        style="font-size: 13px; padding: 16px 44px; letter-spacing: 2px">Request a Spot</a
      >
    </div>
  </div>
</section>
