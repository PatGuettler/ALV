      <div class="tg-step">
        <div class="tg-step-num">04</div>
        <div class="tg-step-title">Play &amp; Enjoy</div>
        <p class="tg-step-body">
          Head to your bay and enjoy two hours of free gameplay — on us, because you served.
        </p>
      </div>
