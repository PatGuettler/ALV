---
const base = import.meta.env.BASE_URL;
---

<footer>
  <div class="container">
    <div style="margin-bottom: 44px">
      <div class="integration-notice integration-notice--dark">
        <h3>Quarterly newsletter coming soon</h3>
        <p>
          ALV is preparing an opt-in newsletter featuring veterans served, program updates, photos,
          and documentary stories. Signup will open after consent, preferences, and unsubscribe
          controls are connected.
        </p>
      </div>
    </div>
    <div class="foot-grid">
      <div>
        <div class="foot-logo">
          <img
            src={`${base}assets/93198b7ec08230d7.png`}
            alt="Alabama Veteran"
            loading="lazy"
            decoding="async"
          />
        </div>
        <p class="foot-blurb">
          Serving those who served. Volunteer-powered and mission-driven since 2016. Platinum
          Transparency rated.
        </p>
        <p class="foot-addr">
          4000 Eagle Point Corporate Dr<br />Birmingham, AL 35242<br />info@alabamaveteran.org
        </p>
        <div class="foot-social">
          <a
            href="https://www.facebook.com/alabamaveteran1/"
            class="s-btn"
            target="_blank"
            rel="noopener noreferrer">Fb</a
          ><a
            href="https://twitter.com/alabama_veteran"
            class="s-btn"
            target="_blank"
            rel="noopener noreferrer">X</a
          ><a
            href="https://www.instagram.com/alabama_veteran/"
            class="s-btn"
            target="_blank"
            rel="noopener noreferrer">Ig</a
          ><a
            href="https://www.tiktok.com/@alabama_veteran"
            class="s-btn"
            target="_blank"
            rel="noopener noreferrer">Tk</a
          ><a
            href="https://www.youtube.com/@AlabamaVeteranWeGY6"
            class="s-btn"
            target="_blank"
            rel="noopener noreferrer">Yt</a
          ><a
            href="https://www.linkedin.com/company/alabama-veteran"
            class="s-btn"
            target="_blank"
            rel="noopener noreferrer">Li</a
          >
        </div>
      </div>
      <div>
        <div class="foot-col-head">Resources</div>
        <ul class="foot-links">
          <li>
            <a
              href="https://va.alabama.gov/serviceofficer/"
              target="_blank"
              rel="noopener noreferrer">Find a VSO Near You</a
            >
          </li>
          <li>
            <a href={`${base}events/`}>Our Events</a>
          </li>
          <li>
            <a href={`${base}resources/`}>Our Resources</a>
          </li>
          <li>
            <a href={`${base}about/`}>Our Initiatives</a>
          </li>
          <li>
            <a href={`${base}about/`}>Board of Directors</a>
          </li>
          <li>
            <a
              href="https://projects.propublica.org/nonprofits/organizations/813938705/"
              target="_blank"
              rel="noopener noreferrer">Our Financials</a
            >
          </li>
          <li>
            <a
              href="https://my.onecause.com/fundraiser/organizations/069c5aa7-32be-4377-be03-b101310beee7/fundraisers/fundraiser:fd94be2b-b4ba-4e2a-b112-1ae8d3c376ee"
              target="_blank"
              rel="noopener noreferrer"
              class="foot-accent"
              style="font-weight: 700">Donate</a
            >
          </li>
        </ul>
      </div>
      <div>
        <div class="foot-col-head">Initiatives</div>
        <ul class="foot-links">
          <li>
            <a href={`${base}warrior-retreat/`}>Warrior Retreat</a>
          </li>
          <li>
            <a href={`${base}warrior-retreat/`}>Marriage Retreat</a>
          </li>
          <li>
            <a href={`${base}warrior-retreat/`}>Peer-to-Peer Programs</a>
          </li>
          <li>
            <a href={`${base}warrior-retreat/`}>AV Ambassador Program</a>
          </li>
          <li>
            <a href={`${base}events/`}>War on the Greens</a>
          </li>
          <li>
            <a href={`${base}events/`}>Salute to Service Gala</a>
          </li>
        </ul>
      </div>
      <div>
        <div class="foot-col-head">Get Help</div>
        <ul class="foot-links">
          <li>
            <a
              href="https://app.alabamaveteran.org/widget/form/t9pQuFrpT0Yz2lYTwLVj?notrack=true"
              target="_blank"
              rel="noopener noreferrer"
              class="foot-accent"
              style="font-weight: 700">9 Line — Crisis Help Now</a
            >
          </li>
          <li>
            <a href={`${base}resources/`}>Navigate Resources</a>
          </li>
          <li>
            <a
              href="https://app.alabamaveteran.org/widget/form/oA6BYtFTZ47lbNChjt2h?notrack=true"
              target="_blank"
              rel="noopener noreferrer">Volunteer</a
            >
          </li>
          <li>
            <a href="mailto:info@alabamaveteran.org" data-contact>Contact Us</a>
          </li>
          <li>
            <a href={`${base}av-circle/`}>AV Circle Membership</a>
          </li>
          <li>
            <a href={`${base}av-active/`}>AV Active App</a>
          </li>
        </ul>
        <div style="margin-top: 20px">
          <img
            src="https://alabamaveteran.org/wp-content/uploads/2026/01/canded-badge.png"
            alt="Platinum Transparency"
            loading="lazy"
            decoding="async"
            style="height: 52px; opacity: 0.7"
          />
        </div>
      </div>
    </div>
    <div class="foot-bottom">
      <span>© 2026 Alabama Veteran — All Rights Reserved</span><span>alabamaveteran.org</span>
    </div>
  </div>
</footer>
