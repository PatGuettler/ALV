---
interface Props {
  heading?: string;
  lede?: string;
}

const {
  heading = 'Get Resources & Updates',
  lede = 'Benefits news, event invites, and the latest from AV News, straight to your inbox.',
} = Astro.props;
---

<div class="av-signup">
  <div class="su-text">
    <div class="su-eyebrow">Stay Connected</div>
    <h3>{heading}</h3>
    <p>{lede}</p>
  </div>
  <div class="su-form">
    <button class="su-open" type="button" data-subscribe>Click to subscribe</button>
    <p class="su-note">Opens the signup form here. You will not leave this page.</p>
  </div>
</div>
