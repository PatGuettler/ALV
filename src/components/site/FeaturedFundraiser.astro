---
const base = import.meta.env.BASE_URL;
const feedUrl = `${base}data/featured-fundraiser.json`;
---

<aside
  class="featured-fundraiser"
  data-featured-fundraiser
  data-feed-url={feedUrl}
  aria-label="Upcoming fundraiser"
  hidden
>
  <span class="featured-fundraiser-star" aria-hidden="true">★</span>
  <span class="featured-fundraiser-label">Upcoming fundraiser:</span>
  <span data-featured-date></span>
  <span class="featured-fundraiser-separator" aria-hidden="true">·</span>
  <strong data-featured-title></strong>
  <span data-featured-venue hidden></span>
  <a data-featured-link target="_blank" rel="noopener noreferrer">More info →</a>
</aside>

<script>
  import '../../scripts/featured-fundraiser.js';
</script>
