---
const base = import.meta.env.BASE_URL;
---

<div id="contact-modal" class="cm-overlay" onclick="if (event.target === this) closeContact();">
  <div class="cm-box">
    <button class="cm-close" onclick="closeContact()" aria-label="Close">×</button>
    <div class="cm-eyebrow">Get In Touch</div>
    <h3 id="cm-title">Contact Alabama Veteran</h3>
    <p class="cm-sub">
      Send us a message and we’ll get back to you. You can also email us directly at
      <a id="cm-email" href="mailto:info@alabamaveteran.org">info@alabamaveteran.org</a>.
    </p>
    <form onsubmit="return sendContact(this);">
      <input name="cname" type="text" placeholder="Your name" required="" /><input
        name="cemail"
        type="email"
        placeholder="Your email"
        required=""
      /><textarea name="cmsg" rows="4" placeholder="How can we help?" required=""></textarea><button
        type="submit"
        class="cm-send">Send Message</button
      >
    </form>
    <div class="cm-addr">Alabama Veteran · 4000 Eagle Point Corporate Dr, Birmingham, AL 35242</div>
  </div>
</div>
