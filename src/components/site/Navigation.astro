  >
  <ul class="nav-links">
    <li><a href={`${base}`} id="nb-home">Home</a></li>
    <li><a href={`${base}av-circle/`} id="nb-circle">AV Circle</a></li>
    <li><a href={`${base}warrior-retreat/`} id="nb-warrior">Warrior Retreat</a></li>
