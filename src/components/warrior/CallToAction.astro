---
const base = import.meta.env.BASE_URL;
---

<section class="wr-cta">
  <div class="container">
    <div class="redbar ctr" style="margin-bottom: 28px"></div>
    <h2>READY TO TAKE<br />THE <span class="red">NEXT STEP?</span></h2>
    <p>
      Whether you're a veteran ready to attend a retreat, a spouse looking for support, or someone
      who wants to serve as an Ambassador — we have a place for you.
    </p>
    <div class="wr-cta-btns">
      <a href={`${base}warrior-retreat-application/`} class="btn-r">Apply for a Retreat</a><a
        href="https://app.alabamaveteran.org/widget/form/oA6BYtFTZ47lbNChjt2h?notrack=true"
        class="btn-b"
        target="_blank"
        rel="noopener noreferrer">Become a Volunteer</a
      ><a
        href="https://app.alabamaveteran.org/widget/form/t9pQuFrpT0Yz2lYTwLVj?notrack=true"
        class="btn-ow"
        target="_blank"
        rel="noopener noreferrer">Get Help Now (9 Line)</a
      >
    </div>
    <p class="wr-staff-access">
      <a href={`${base}warrior-retreat-staff/`}
        >Warrior Retreat staff login <span aria-hidden="true">→</span></a
      >
    </p>
  </div>
</section>
