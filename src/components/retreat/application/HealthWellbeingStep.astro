<fieldset class="application-step" data-application-step hidden aria-labelledby="health-step-title">
  <legend id="health-step-title">Health and wellbeing</legend>
  <p class="step-intro">
    These questions help staff plan a safe retreat. They are reviewed only by invited ALV staff.
  </p>
  <div class="info-box">
    Your responses are confidential and will not be shared outside of the Warrior Retreat team
    without your consent. This form is not monitored for emergencies. If you need immediate crisis
    support, call 988 and press 1 for the Veterans Crisis Line.
  </div>

  <h2 class="section-label">Mental health assessment</h2>
  <fieldset class="scale-field">
    <legend>Over the past 2 weeks, how often have you felt down, depressed, or hopeless?</legend>
    <div class="mh-scale">
      <label
        ><input name="phqHopeless" type="radio" value="0" /><span>0<br />Not at all</span></label
      >
      <label
        ><input name="phqHopeless" type="radio" value="1" /><span>1<br />Several days</span></label
      >
      <label
        ><input name="phqHopeless" type="radio" value="2" /><span>2<br />More than half</span
        ></label
      >
      <label
        ><input name="phqHopeless" type="radio" value="3" /><span>3<br />Nearly every day</span
        ></label
      >
    </div>
  </fieldset>
  <fieldset class="scale-field">
    <legend>
      Over the past 2 weeks, how often have you had little interest or pleasure in doing things?
    </legend>
    <div class="mh-scale">
      <label
        ><input name="phqInterest" type="radio" value="0" /><span>0<br />Not at all</span></label
      >
      <label
        ><input name="phqInterest" type="radio" value="1" /><span>1<br />Several days</span></label
      >
      <label
        ><input name="phqInterest" type="radio" value="2" /><span>2<br />More than half</span
        ></label
      >
      <label
        ><input name="phqInterest" type="radio" value="3" /><span>3<br />Nearly every day</span
        ></label
      >
    </div>
  </fieldset>
  <fieldset class="scale-field">
    <legend>How often do you experience anxiety or panic attacks?</legend>
    <div class="mh-scale">
      <label
        ><input name="anxietyFrequency" type="radio" value="0" /><span>0<br />Never</span></label
      >
      <label
        ><input name="anxietyFrequency" type="radio" value="1" /><span>1<br />Rarely</span></label
      >
      <label
        ><input name="anxietyFrequency" type="radio" value="2" /><span>2<br />Sometimes</span
        ></label
      >
      <label
        ><input name="anxietyFrequency" type="radio" value="3" /><span>3<br />Often</span></label
      >
      <label
        ><input name="anxietyFrequency" type="radio" value="4" /><span>4<br />Always</span></label
      >
    </div>
  </fieldset>
  <div class="form-group">
    <span class="form-label"
      >Do you experience nightmares or flashbacks related to your service?</span
    >
    <div class="radio-stack">
      <label><input name="nightmares" type="radio" value="no" /> No</label>
      <label><input name="nightmares" type="radio" value="occasionally" /> Occasionally</label>
      <label><input name="nightmares" type="radio" value="frequently" /> Frequently</label>
    </div>
  </div>
  <fieldset class="scale-field">
    <legend>How would you rate your overall mental health right now?</legend>
    <div class="mh-scale">
      <label
        ><input name="mentalHealthOverall" type="radio" value="1" /><span>1<br />Very poor</span
        ></label
      >
      <label
        ><input name="mentalHealthOverall" type="radio" value="2" /><span>2<br />Poor</span></label
      >
      <label
        ><input name="mentalHealthOverall" type="radio" value="3" /><span>3<br />Fair</span></label
      >
      <label
        ><input name="mentalHealthOverall" type="radio" value="4" /><span>4<br />Good</span></label
      >
      <label
        ><input name="mentalHealthOverall" type="radio" value="5" /><span>5<br />Excellent</span
        ></label
      >
    </div>
  </fieldset>

  <div class="form-group">
    <span class="form-label">Have you ever been diagnosed with any of the following?</span>
    <div class="check-grid">
      <label><input name="diagnoses" type="checkbox" value="ptsd" /> PTSD</label>
      <label
        ><input name="diagnoses" type="checkbox" value="tbi" /> TBI (traumatic brain injury)</label
      >
      <label><input name="diagnoses" type="checkbox" value="depression" /> Depression</label>
      <label><input name="diagnoses" type="checkbox" value="anxiety" /> Anxiety disorder</label>
      <label
        ><input name="diagnoses" type="checkbox" value="mst" /> Military sexual trauma (MST)</label
      >
      <label
        ><input name="diagnoses" type="checkbox" value="substance" /> Substance use disorder</label
      >
      <label><input name="diagnoses" type="checkbox" value="moral-injury" /> Moral injury</label>
      <label><input name="diagnoses" type="checkbox" value="none" /> None of the above</label>
    </div>
  </div>

  <div class="field-grid">
    <label class="form-field"
      >Currently seeing a mental health provider?
      <select name="inCare">
        <option value="">Select…</option>
        <option value="yes">Yes</option>
        <option value="no">No</option>
        <option value="waitlist">On a waitlist</option>
      </select>
    </label>
    <label class="form-field"
      >Have you ever considered or attempted suicide?
      <select name="suicideHistory">
        <option value="">Select…</option>
        <option value="no">No</option>
        <option value="thoughts">I have had thoughts but no attempt</option>
        <option value="past">Yes, in the past</option>
        <option value="prefer-not-to-say">Prefer not to say</option>
      </select>
    </label>
    <label class="form-field field-span"
      >Are you currently in a crisis or need immediate mental health support?
      <select name="crisisStatus">
        <option value="">Select…</option>
        <option value="stable">No, I am stable</option>
        <option value="struggling">I am struggling but managing</option>
        <option value="need-support">Yes, I need support soon</option>
      </select>
    </label>
  </div>

  <h2 class="section-label">Medical information</h2>
  <div class="field-grid">
    <label class="form-field field-span"
      >Current medical conditions or health risks
      <textarea name="medicalConditions" rows="3" maxlength="1500"></textarea>
    </label>
    <label class="form-field field-span"
      >Medications currently taking
      <textarea name="medications" rows="3" maxlength="1500"></textarea>
    </label>
    <label class="form-field field-span"
      >Known allergies (food, medication, environmental)
      <textarea name="allergies" rows="3" maxlength="1000"></textarea>
    </label>
    <label class="form-field"
      >Physical limitations or mobility concerns
      <input name="mobility" type="text" maxlength="200" />
    </label>
    <label class="form-field"
      >Dietary restrictions
      <input name="dietary" type="text" maxlength="200" />
    </label>
  </div>

  <h2 class="section-label">Service dog</h2>
  <div class="radio-stack">
    <label><input name="serviceDog" type="radio" value="none" /> No service dog</label>
    <label
      ><input name="serviceDog" type="radio" value="bringing" /> I have a service dog and will be bringing
      them</label
    >
    <label
      ><input name="serviceDog" type="radio" value="not-bringing" /> I have a service dog but will not
      be bringing them</label
    >
  </div>
  <section class="conditional-panel" data-condition="service-dog-details" hidden>
    <div class="field-grid">
      <label class="form-field"
        >Dog's name
        <input name="dogName" type="text" maxlength="60" disabled />
      </label>
      <label class="form-field"
        >Breed
        <input name="dogBreed" type="text" maxlength="80" disabled />
      </label>
      <label class="form-field"
        >Certification number (if applicable)
        <input name="dogCertification" type="text" maxlength="80" disabled />
      </label>
      <label class="form-field"
        >Tasks the dog performs
        <input name="dogTasks" type="text" maxlength="200" disabled />
      </label>
    </div>
  </section>
</fieldset>
