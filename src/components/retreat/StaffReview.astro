---
interface Props {
  apiUrl: string;
  cognitoDomain: string;
  clientId: string;
}

const { apiUrl, cognitoDomain, clientId } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<main class="retreat-status retreat-staff-page">
  <header class="retreat-staff-login-header">
    <div class="retreat-staff-mark" aria-hidden="true"><span>ALV</span><span>Staff</span></div>
    <div>
      <div class="eyebrow">Alabama Veteran · Secure staff portal</div>
      <h1>Warrior Retreat review</h1>
      <p id="retreat-staff-copy">
        Review retreat applications and record staff decisions. Sign in with the Cognito account
        issued to you by the ALV administrator; this is not the AWS access portal.
      </p>
    </div>
  </header>
  <div class="retreat-staff-security">
    <span>Invite-only access</span><span>Encrypted applicant records</span><span
      >Audited decisions</span
    >
  </div>
  <div class="retreat-staff-actions retreat-staff-login-actions">
    <button id="retreat-staff-signin" type="button">Continue to secure sign in</button>
    <button id="retreat-staff-signout" type="button" hidden>Sign out</button>
  </div>
  <p id="retreat-staff-status" class="retreat-form-status" role="status" aria-live="polite"></p>
  <div id="retreat-staff-list" hidden>
    <div class="retreat-staff-filters">
      <label class="retreat-filter">
        Status
        <select id="retreat-staff-status-filter">
          <option value="submitted">Submitted</option>
          <option value="approved">Approved</option>
          <option value="waitlisted">Waitlisted</option>
          <option value="declined">Declined</option>
          <option value="cancelled">Cancelled</option>
        </select>
      </label>
      <label class="retreat-filter">
        Search this list
        <input id="retreat-staff-search" type="search" autocomplete="off" />
      </label>
    </div>
    <ul id="retreat-staff-items" class="retreat-staff-items"></ul>
  </div>
  <dialog id="retreat-staff-dialog" class="retreat-staff-dialog">
    <div class="eyebrow">Restricted staff view</div>
    <h2 id="retreat-staff-dialog-title">Application</h2>
    <div id="retreat-staff-detail" class="retreat-staff-detail"></div>
    <div class="retreat-staff-decision">
      <label class="retreat-filter">
        Decision
        <select id="retreat-staff-decision-status">
          <option value="submitted">Submitted</option>
          <option value="approved">Approved</option>
          <option value="waitlisted">Waitlisted</option>
          <option value="declined">Declined</option>
          <option value="cancelled">Cancelled</option>
        </select>
      </label>
      <label class="retreat-filter">
        Internal review note
        <textarea id="retreat-staff-note" rows="4" maxlength="1000"></textarea>
      </label>
    </div>
    <p id="retreat-staff-dialog-status" class="retreat-form-status" role="status"></p>
    <div class="retreat-staff-actions">
      <button id="retreat-staff-save" type="button">Save decision</button>
      <button id="retreat-staff-close" class="button-secondary" type="button">Close</button>
    </div>
  </dialog>
  <p class="return-link">
    <a href={`${base}warrior-retreat/`}>Return to Warrior Retreat</a>
  </p>
</main>

<script is:inline define:vars={{ apiUrl, cognitoDomain, clientId, base }}>
  window.__RETREAT_STAFF__ = { apiUrl, cognitoDomain, clientId, base };
</script>
<script>
  import '../../scripts/retreat-staff.js';
</script>
