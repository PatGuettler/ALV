---
interface Props {
  apiUrl: string;
  cognitoDomain: string;
  clientId: string;
}

const { apiUrl, cognitoDomain, clientId } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<main class="retreat-staff-page">
  <header class="admin-header">
    <img
      class="admin-logo"
      src={`${base}assets/warrior-retreat-mark.png`}
      alt="Warrior Retreat"
      height="70"
    />
    <h1>Retreat Administration</h1>
    <div class="admin-actions retreat-staff-actions retreat-staff-login-actions">
      <button id="retreat-staff-signin" class="btn" type="button">Continue to secure sign in</button
      >
      <button id="retreat-staff-signout" class="btn" type="button" hidden>Sign out</button>
      <a class="button-secondary" href={`${base}warrior-retreat-application/`}>Public apply form</a>
    </div>
    <p id="retreat-staff-copy">
      Review submitted Warrior Retreat applications from the ALV production queue. Sign in with the
      Cognito account issued to you by the ALV administrator; this is not the AWS access portal.
    </p>
  </header>

  <div class="retreat-staff-security">
    <span>Invite-only access</span><span>Live DynamoDB applications</span><span
      >Audited decisions</span
    >
  </div>
  <p id="retreat-staff-status" class="retreat-form-status" role="status" aria-live="polite"></p>

  <div id="retreat-staff-list" hidden>
    <div class="stat-grid">
      <div class="stat-card">
        <div class="s-label">Total applications</div>
        <div class="s-val" id="retreat-stat-total">0</div>
        <div class="s-sub">Loaded from the production queue</div>
      </div>
      <div class="stat-card">
        <div class="s-label">Pending review</div>
        <div class="s-val" id="retreat-stat-submitted">0</div>
        <div class="s-sub">Status: submitted</div>
      </div>
      <div class="stat-card">
        <div class="s-label">Approved</div>
        <div class="s-val" id="retreat-stat-approved">0</div>
        <div class="s-sub">Confirmed attendees</div>
      </div>
      <div class="stat-card">
        <div class="s-label">Return applicants</div>
        <div class="s-val" id="retreat-stat-returning">0</div>
        <div class="s-sub">Listed a previous ALV retreat</div>
      </div>
    </div>

    <div class="filters">
      <span class="filter-label">Filter</span>
      <label class="retreat-filter">
        Retreat
        <select id="retreat-staff-retreat-filter">
          <option value="">All retreats</option>
          <option value="mens">Men's Retreat</option>
          <option value="womens">Women's Retreat</option>
          <option value="marriage">Marriage Retreat</option>
          <option value="endurance">Endurance Retreat</option>
        </select>
      </label>
      <label class="retreat-filter">
        Status
        <select id="retreat-staff-status-filter">
          <option value="">All statuses</option>
          <option value="submitted">Submitted</option>
          <option value="approved">Approved</option>
          <option value="waitlisted">Waitlisted</option>
          <option value="declined">Declined</option>
          <option value="cancelled">Cancelled</option>
        </select>
      </label>
      <label class="retreat-filter">
        Type
        <select id="retreat-staff-type-filter">
          <option value="">All types</option>
          <option value="military">Veteran / military</option>
          <option value="first-responder">First responder</option>
        </select>
      </label>
      <label class="retreat-filter">
        Search this list
        <input id="retreat-staff-search" type="search" autocomplete="off" />
      </label>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Applicant</th>
            <th>Type</th>
            <th>Retreat</th>
            <th>Timing</th>
            <th>Status</th>
            <th>Past retreats</th>
            <th>Applied</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody id="retreat-staff-items"></tbody>
      </table>
    </div>
  </div>

  <dialog id="retreat-staff-dialog" class="retreat-staff-dialog">
    <div class="eyebrow">Restricted staff view</div>
    <h2 id="retreat-staff-dialog-title">Application</h2>
    <div id="retreat-staff-detail" class="retreat-staff-detail"></div>
    <div class="retreat-staff-decision">
      <label class="retreat-filter">
        Decision
        <select id="retreat-staff-decision-status">
          <option value="submitted">Submitted</option>
          <option value="approved">Approved</option>
          <option value="waitlisted">Waitlisted</option>
          <option value="declined">Declined</option>
          <option value="cancelled">Cancelled</option>
        </select>
      </label>
      <label class="retreat-filter">
        Internal review note
        <textarea id="retreat-staff-note" rows="4" maxlength="1000"></textarea>
      </label>
    </div>
    <p id="retreat-staff-dialog-status" class="retreat-form-status" role="status"></p>
    <div class="retreat-staff-actions">
      <button id="retreat-staff-save" type="button">Save decision</button>
      <button id="retreat-staff-close" class="button-secondary" type="button">Close</button>
    </div>
  </dialog>
  <p class="return-link">
    <a href={`${base}warrior-retreat/`}>Return to Warrior Retreat</a>
  </p>
</main>

<script is:inline define:vars={{ apiUrl, cognitoDomain, clientId, base }}>
  window.__RETREAT_STAFF__ = { apiUrl, cognitoDomain, clientId, base };
</script>
<script>
  import '../../scripts/retreat-staff.js';
</script>
