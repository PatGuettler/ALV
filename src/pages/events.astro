---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/events/Hero.astro';
import EventsFundraising from '../components/events/EventsFundraising.astro';
import EventsMonthStrip from '../components/events/EventsMonthStrip.astro';
import EventsCalendar from '../components/events/EventsCalendar.astro';
import EventsSubscribe from '../components/events/EventsSubscribe.astro';
import WogModals from '../components/events/WogModals.astro';
import '../styles/events.css';
---

<SiteLayout
  pageId="events"
  title="Events | Alabama Veteran"
  description="Upcoming Alabama Veteran fundraisers, community programs, and events."
>
  <div id="page-events" class="page active">
    <Hero />
    <EventsFundraising />
    <EventsMonthStrip />
    <EventsCalendar />
    <EventsSubscribe />
    <WogModals />
  </div>
</SiteLayout>
