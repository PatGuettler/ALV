---
import SiteLayout from '../layouts/SiteLayout.astro';
import Hero from '../components/home/Hero.astro';
import MissionStrip from '../components/home/MissionStrip.astro';
import Initiatives from '../components/home/Initiatives.astro';
import Fundraisers from '../components/home/Fundraisers.astro';
import Testimonials from '../components/home/Testimonials.astro';
import CirclePreview from '../components/home/CirclePreview.astro';
import UpcomingEvents from '../components/home/UpcomingEvents.astro';
import Sponsors from '../components/home/Sponsors.astro';
import Transparency from '../components/home/Transparency.astro';
import NewsPreview from '../components/home/NewsPreview.astro';
import CommunityCallToAction from '../components/home/CommunityCallToAction.astro';
import '../styles/home.css';
---

<SiteLayout
  pageId="home"
  title="Alabama Veteran — We've Got Your Six"
  description="Serving Alabama veterans through community, resources, retreats, and direct support."
>
  <div id="page-home" class="page active">
    <Hero />
    <MissionStrip />
    <Initiatives />
    <Fundraisers />
    <Testimonials />
    <CirclePreview />
    <UpcomingEvents />
    <Sponsors />
    <Transparency />
    <NewsPreview />
    <CommunityCallToAction />
  </div>
</SiteLayout>
