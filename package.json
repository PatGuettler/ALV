{
  "name": "alabama-veteran-website",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Component-based Astro website for Alabama Veteran.",
  "scripts": {
    "dev": "astro dev --host 0.0.0.0",
    "build": "astro build",
    "check": "astro check",
    "format": "prettier --write \"src/**/*.{astro,css,js,json}\" \"scripts/**/*.mjs\" \"*.{js,json,mjs}\" README.md DEVELOPER_HANDOFF.md PRODUCTION_PLAN.md MOCK_DATA_AUDIT.md \".github/**/*.{yml,yaml}\"",
    "format:check": "prettier --check \"src/**/*.{astro,css,js,json}\" \"scripts/**/*.mjs\" \"*.{js,json,mjs}\" README.md DEVELOPER_HANDOFF.md PRODUCTION_PLAN.md MOCK_DATA_AUDIT.md \".github/**/*.{yml,yaml}\"",
    "preview": "astro preview --host 0.0.0.0",
    "test": "npm run test:site && npm run test:rollup",
    "test:browser": "npm run build && node scripts/browser-smoke.mjs",
    "test:rollup": "node --test \"scripts/tests/**/*.test.mjs\"",
    "test:site": "node scripts/validate-site.mjs",
    "sync:events": "node scripts/sync-events-calendar.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.6",
    "@astrojs/sitemap": "3.7.4",
    "@axe-core/playwright": "4.13.0",
    "astro": "7.2.10",
    "chrome-launcher": "1.2.1",
    "lighthouse": "13.4.1",
    "playwright-core": "1.62.1",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=22.12"
  }
}
